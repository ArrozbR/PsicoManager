<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · PsicoManager</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app">
        <aside class="sidebar">
            <div class="brand">
                <span class="brand-mark">P</span>
                <span class="brand-name">PsicoManager</span>
            </div>
            <nav class="nav">
                <a class="nav-item @Active("Home")" asp-controller="Home" asp-action="Index">
                    <span class="ico">▦</span> Dashboard
                </a>
                <a class="nav-item @Active("Agenda")" asp-controller="Agenda" asp-action="Index">
                    <span class="ico">▤</span> Agenda
                </a>
                <a class="nav-item @Active("Prontuario")" asp-controller="Prontuario" asp-action="Index">
                    <span class="ico">▣</span> Prontuários
                </a>
                <a class="nav-item @Active("Financeiro")" asp-controller="Financeiro" asp-action="Index">
                    <span class="ico">▥</span> Financeiro
                </a>
                <a class="nav-item @Active("Pacientes")" asp-controller="Pacientes" asp-action="Index">
                    <span class="ico">▧</span> Pacientes
                </a>
            </nav>
            <div class="sidebar-foot">
                <div class="badge-mock">dados mockados</div>
            </div>
        </aside>

        <main class="content">
            <header class="topbar">
                <h1>@ViewData["Title"]</h1>
                <div class="user">
                    <div class="avatar">AC</div>
                    <div class="user-info">
                        <strong>Dra. Ana Beatriz Costa</strong>
                        <small>CRP GO/012345</small>
                    </div>
                </div>
            </header>
            <div class="page">
                @RenderBody()
            </div>
        </main>
    </div>
</body>
</html>

@functions {
    string Active(string controller)
    {
        var current = ViewContext.RouteData.Values["controller"]?.ToString();
        return string.Equals(current, controller, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }
}
